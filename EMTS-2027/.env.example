# ETIMS 2027 & GANESHA AI Assistant Environment Configuration
# Copy this file to .env and fill in your OpenAI API key to enable
# OpenAI vector embeddings, GPT-4o-mini conversational RAG, neural TTS, and Whisper STT.
# Never commit .env or expose OPENAI_API_KEY in frontend code.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_STT_MODEL=whisper-1
API_PORT=3001

